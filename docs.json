{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Maria Cristoforo",
  "description": "Designer, engineer, and writer based in San Francisco.",
  "colors": {
    "primary": "#ea580c",
    "light": "#f97316",
    "dark": "#c2410c"
  },
  "appearance": {
  "default": "light"
},
"background": {
    "color": {
      "light": "#F8F5EF",
      "dark": "#1C1917"
    }
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "api": {
    "mdx": {
      "server": "https://maria-api.vercel.app"
    },
    "playground": {
      "display": "interactive",
      "proxy": false
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        }
        ]
    },
    "groups": [
      {
        "group": "About",
        "icon": "user",
        "expanded": true,
        "pages": [
          "about/skills",
          "about/changelog"
        ]
      },
      {
        "group": "Case Studies",
        "icon": "briefcase",
        "expanded": true,
        "pages": [
          "work/overview",
          "work/canvas-annotation-revamp",
          "work/turn-based-audio-annotation",
          "work/apilens",
          "work/portfolio"
        ]
      },
      {
        "group": "Writing",
        "icon": "pen-line",
        "expanded": true,
        "pages": [
          "writing/overview",
          "writing/the-design-process-shift",
          "writing/ux-friction-coefficient"
        ]
      },
      {
        "group": "API Reference",
        "icon": "terminal",
        "expanded": true,
        "pages": [
          "api/get-me",
          "api/get-skills",
          "api/get-availability",
          "api/post-hire",
          "api/post-contact"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/MariaC27",
        "icon": "github"
      },
      {
        "label": "LinkedIn",
        "href": "https://www.linkedin.com/in/maria-cristoforo/",
        "icon": "linkedin"
      },
      {
        "label": "Medium",
        "href": "https://medium.com/@maria_cristoforo",
        "icon": { "name": "medium", "library": "fontawesome", "style": "brands" }
      },
      {
        "label": "Email",
        "href": "mailto:maria.h.cristoforo@gmail.com",
        "icon": "mail"
      }
    ]
  },
  "redirects": [
    { "source": "/reference/skills", "destination": "/about/skills" },
    { "source": "/reference/changelog", "destination": "/about/changelog" }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/MariaC27/docs"
    }
  },
  "seo": {
    "metatags": {
        "canonical": "https://www.mariacristoforo.com"
    }
}
}
