{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "[Your Name]",
  "description": "Design engineer building AI-native interfaces.",
  "colors": {
    "primary": "#ea580c",
    "light": "#f97316",
    "dark": "#c2410c"
  },
  "background": {
    "color": {
      "light": "#F8F5EF",
      "dark": "#1C1917"
    }
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Home",
          "icon": "house",
          "href": "/"
        },
        {
          "anchor": "Agent view",
          "icon": "terminal",
          "href": "/agent"
        },
        {
          "anchor": "Resume",
          "icon": "file-text",
          "href": "https://placeholder.example.com/resume.pdf"
        }
      ]
    },
    "groups": [
      {
        "group": "Case Studies",
        "icon": "briefcase",
        "expanded": true,
        "pages": [
          "work/overview",
          "work/apilens",
          "work/canvas-annotation-revamp",
          "work/turn-based-audio-annotation"
        ]
      },
      {
        "group": "Writing",
        "icon": "pen-line",
        "expanded": true,
        "pages": [
          "writing/overview",
          "writing/the-design-process-shift",
          "writing/ux-friction-coefficient"
        ]
      },
      {
        "group": "Reference",
        "icon": "code-xml",
        "expanded": true,
        "pages": [
          "reference/skills",
          "reference/experience",
          "reference/contact"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/placeholder",
        "icon": "github"
      },
      {
        "label": "LinkedIn",
        "href": "https://linkedin.com/in/placeholder",
        "icon": "linkedin"
      },
      {
        "label": "Email",
        "href": "mailto:placeholder@example.com",
        "icon": "mail"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/placeholder",
      "linkedin": "https://linkedin.com/in/placeholder",
      "x": "https://x.com/placeholder"
    }
  }
}
